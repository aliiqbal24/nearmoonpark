# Local Workers read ignored .dev.vars. Never commit real values.
# Moonpark: testnet only. Generated by npm run deploy:testnet.
MOON_SPONSOR_ID=
MOON_SPONSOR_KEY=
MOON_CONTRACT_ID=
# Hosted Sites identity gateway only; production .chatgpt.site with matching BETTER_AUTH_URL.
MOON_CHATGPT_AUTH=0
# Optional Google alternative for standalone hosting.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
# Hosted: https://last-signal-mars.ajiqbal1.chatgpt.site
# Local: http://localhost:5173
BETTER_AUTH_URL=
# Retained earlier Mars prototype at /legacy.
NEAR_SPONSOR_ID=
NEAR_SPONSOR_KEY=
NEAR_CONTRACT_ID=
